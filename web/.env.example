# Copy this file to `.env` and fill in the values.
#   cp .env.example .env   (then run: npx prisma migrate dev)

# Local-first SQLite database. Swap for a Postgres URL to go cloud.
DATABASE_URL="file:./dev.db"

# Where uploaded screenshots are stored by the local storage provider.
# (Relative to the web/ project root.)
STORAGE_DIR="./storage/uploads"

# Public base URL of this app (used to build share links).
NEXT_PUBLIC_APP_URL="http://localhost:5000"

# Anthropic API key — required for the "Rephrase docs" AI feature.
# Get one at https://console.anthropic.com/ . Restart the dev server after setting it.
ANTHROPIC_API_KEY=""
# Optional: override the model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL="claude-opus-4-8"
